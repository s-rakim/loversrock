# Copy to .env and fill in.

PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Postgres. These hostnames are for running the backend directly on the host
# (`npm start`) against the compose-managed Postgres/MinIO. Under
# `docker compose up` the backend runs inside the network and reaches the other
# services by service name, so docker-compose.yml overrides DATABASE_URL and
# STORAGE_ENDPOINT for that case — leave these as-is and both paths work.
DATABASE_URL=postgres://loversrock:loversrock@localhost:5432/loversrock

# MinIO (self-hosted, S3-compatible). Swap for AWS S3 by pointing
# STORAGE_ENDPOINT at s3.amazonaws.com, STORAGE_USE_SSL=true, and using real
# AWS keys — no code changes required.
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=loversrock
STORAGE_SECRET_KEY=loversrock123
STORAGE_BUCKET=loversrock

# Firebase Cloud Messaging — the app's only cloud dependency, required even
# for a fully local deployment. Paste the full service-account JSON as a
# single-line string (from a free Firebase project).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated list of allowed CORS origins (mobile dev client / Expo web preview)
CORS_ORIGINS=http://localhost:19006

# Daily prompts. Six fresh relationship questions are fetched each night at
# 04:00 on a randomly chosen topic and scheduled onto upcoming promptless days.
# Two providers are tried in order; whichever is configured wins, and the
# local bank always catches a failure so the app is never without a prompt.
#
#   1. HTTP     - a link to any page or feed of questions. Handles a JSON
#                 array, {"questions": [...]}, one question per line, or an
#                 ordinary HTML page (markup stripped, entities decoded, both
#                 list items and questions buried in prose picked up).
#                 Several comma-separated URLs are tried in random order, so
#                 one page is never the only input and a dead link falls
#                 through to the next.
#   2. Local    - the seeded bank, reshuffled. No configuration, no network.
# Check a list before trusting it:  npm run prompts:probe
# Pages that build their questions with JavaScript return nothing to a plain
# fetch - the probe tells you which of yours are actually readable.
PROMPT_SOURCE_URL=https://www.couplesinstitute.com/play-twenty-questions-with-your-partner/,https://www.gottman.com/how-well-do-you-know-your-partner/quiz/,https://www.connectedcouples.app/quizzes,https://www.toointoyou.ie/relationships/quiz/,https://www.psychologytoday.com/us/tests/relationships

# TURN relay (docker/turnserver.conf). Without one, a call rings, negotiates,
# and then never connects whenever the two phones have no direct path — which
# is the normal case on mobile data behind carrier-grade NAT.
#
# TURN_PUBLIC_IP must be the address the PHONES can reach: your Tailscale IP,
# not localhost and not a Docker-internal name.
TURN_SECRET=change-me-turn-secret
TURN_PUBLIC_IP=
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Fresh daily-quiz questions from a language model — optional. Leave these
# empty and the quiz keeps recycling its own questions, as it always has.
# Full guide, and which providers have free tiers: docs/QUIZ.md
#
#   QUIZ_LLM_PROVIDER  anthropic | openai | gemini | groq | openrouter |
#                      mistral | deepseek | together | ollama | custom
#   QUIZ_LLM_API_KEY   the key from that provider (none needed for ollama)
#   QUIZ_LLM_MODEL     the model name from that provider's docs; optional for
#                      anthropic (claude-opus-5 by default; claude-haiku-4-5
#                      is the cheapest and plenty for this)
#   QUIZ_LLM_BASE_URL  only for `custom`, or to override a provider's address
# Check it works:  npm run quiz:generate -- --dry-run
QUIZ_LLM_PROVIDER=
QUIZ_LLM_API_KEY=
QUIZ_LLM_MODEL=
QUIZ_LLM_BASE_URL=
