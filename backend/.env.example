# Copy this to .env and fill in real values. .env is gitignored.

PORT=4000
NODE_ENV=development

# Matches docker-compose.yml — only change if you're not using docker-compose
DATABASE_URL=postgres://candle:candle_dev_password@localhost:5432/candleapp

# JWT
JWT_ACCESS_SECRET=change_me_dev_only
JWT_REFRESH_SECRET=change_me_dev_only_too
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# MinIO (local S3-compatible storage) — matches docker-compose.yml
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=candle_minio
MINIO_SECRET_KEY=candle_minio_password
MINIO_BUCKET=candleapp-media
MINIO_USE_SSL=false

# Firebase Cloud Messaging — required even for local dev (FCM itself is cloud-hosted)
# Create a free Firebase project, generate a service account key, paste the JSON
# as a single-line string here, or point to a mounted file path instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
