{
  "expo": {
    "name": "loversrock",
    "slug": "loversrock",
    "scheme": "loversrock",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F4F2",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loversrock.app"
    },
    "android": {
      "package": "com.loversrock.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "./plugins/withSplashScreenColor",
      "./plugins/withCleartextTraffic",
      "./plugins/withAndroidWidgets",
      "./plugins/withIosWidgets",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "loversrock uses your location to show how far apart you and your partner are, only while sharing is turned on."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "loversrock uses the camera to take the photo that lands on your partner's home screen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "loversrock needs access to your photos to add them to your shared Memories.",
          "cameraPermission": "loversrock needs your camera to take a photo for your partner’s home screen widget."
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "eas": {
        "projectId": "19b22dec-4d84-432e-973a-05e82edadbfc"
      }
    }
  }
}
