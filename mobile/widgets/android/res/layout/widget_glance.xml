<?xml version="1.0" encoding="utf-8"?>
<!-- One fact, large, with a label above and a line of context below.
     Shared by the anniversary, daily-question, next-date and secret-message
     widgets: they differ in what they put in the three slots, not in shape,
     and four near-identical layouts is four places to fix a padding bug.

     RemoteViews supports a limited view set (no ConstraintLayout before
     Android 12), so this stays LinearLayout-based. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The background: grey glass by default, or the colour, gradient or
         pattern chosen under Settings > Widget look, painted by
         WidgetPainter into this image (GlassStyle.apply). An image rather
         than the root's background because RemoteViews can only swap a
         background for a resource, and a look can be any colours at all. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/glance_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:textColor="@color/widget_text_muted"
                android:text="" />

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/widget_refresh_icon"
                android:contentDescription="Refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/glance_value"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:text="—" />

        <TextView
            android:id="@+id/glance_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/widget_text_muted"
            android:text="" />
    </LinearLayout>
</FrameLayout>
