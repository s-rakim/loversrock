<?xml version="1.0" encoding="utf-8"?>
<!-- The drawing fills the tile; the caption floats at the bottom over it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The background: grey glass by default, or the colour, gradient or
         pattern chosen under Settings > Widget look, painted by
         WidgetPainter into this image (GlassStyle.apply). An image rather
         than the root's background because RemoteViews can only swap a
         background for a resource, and a look can be any colours at all. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/canvas_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Your latest drawing" />

        <TextView
            android:id="@+id/glance_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="8dp"
            android:background="@drawable/widget_caption_scrim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:text="" />

        <TextView
            android:id="@+id/glance_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:padding="8dp"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_muted"
            android:text="" />

        <TextView
            android:id="@+id/glance_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="" />
    </FrameLayout>
</FrameLayout>
