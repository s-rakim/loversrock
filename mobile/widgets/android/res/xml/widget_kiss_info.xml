<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis has a hard 30-minute floor enforced by the framework;
     anything smaller is silently clamped. Tap-to-refresh covers the gap. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="120dp"
    android:minHeight="120dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_kiss"
    android:previewImage="@drawable/widget_preview_kiss"
    android:previewLayout="@layout/widget_kiss"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_kiss_description" />
