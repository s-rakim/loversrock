<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis has a hard 30-minute floor enforced by the framework;
     anything smaller is silently clamped. Tap-to-refresh covers the gap. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_canvas"
    android:previewImage="@drawable/widget_preview_canvas"
    android:previewLayout="@layout/widget_canvas"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:description="@string/widget_canvas_description" />
