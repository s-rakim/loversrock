<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis has a hard 30-minute floor enforced by the framework;
     anything smaller is silently clamped. Tap-to-refresh covers the gap. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_summary"
    android:previewImage="@drawable/widget_preview_summary"
    android:previewLayout="@layout/widget_summary"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_summary_description" />
