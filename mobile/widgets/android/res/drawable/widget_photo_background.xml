<?xml version="1.0" encoding="utf-8"?>
<!-- The locket (partner photo) widget, and only it: NOT glass. The photo is
     the whole widget, edge to edge, so this is just the rounded shape it is
     clipped to and the soft card shown until the first photo arrives. -->
