<?xml version="1.0" encoding="utf-8"?>
<!-- The background of EVERY loversrock widget: grey liquid glass, as far as
     RemoteViews allow. There is no blur of the
     wallpaper on offer to a widget, so the look is built from what glass
     actually shows: a translucent grey body (top a shade lighter than the
     bottom), a sheen that catches the light across the upper half, and a
     bright hairline rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/widget_glass_top"
                android:endColor="@color/widget_glass_bottom" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/widget_glass_sheen"
                android:centerColor="#00FFFFFF"
                android:centerY="0.45"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/widget_glass_rim" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
