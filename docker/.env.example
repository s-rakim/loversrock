# Copy to docker/.env — this is the file `docker compose` substitutes from.
#
# Not to be confused with backend/.env, which is handed to the backend
# CONTAINER. The ${...} placeholders in docker-compose.yml are resolved by
# Compose itself before any container starts, and Compose reads them from
# here (or the shell), never from backend/.env.

# --- TURN relay ---------------------------------------------------------
#
# TURN_PUBLIC_IP is the address the PHONES will use to reach this machine —
# your server's Tailscale IP. Not localhost, not a Docker service name, not
# the LAN address unless both phones are always on that LAN. Leave it unset
# and the backend serves no relay at all, which is the quiet way calls keep
# failing to connect.
TURN_PUBLIC_IP=

# Shared between coturn and the backend, which mints the short-lived
# credentials from it. The two MUST match or every relay auth fails.
# Generate one:  [guid]::NewGuid().ToString("N")
TURN_SECRET=change-me-turn-secret

# The relay port range, mapped through in docker-compose.yml. Twenty ports is
# plenty for two people; every mapped port costs a proxy process.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49180

# --- Postgres / MinIO ---------------------------------------------------
# Only needed if you want something other than the defaults.
# POSTGRES_USER=loversrock
# POSTGRES_PASSWORD=loversrock
# POSTGRES_DB=loversrock
# MINIO_ROOT_USER=loversrock
# MINIO_ROOT_PASSWORD=loversrock123
