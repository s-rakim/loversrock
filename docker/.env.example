# Copy to docker/.env — this is the file `docker compose` substitutes from.
#
# The secrets below are left empty on purpose. Fill them all in one go with
#     node docker/secure-setup.mjs
# from the loversrock folder: it writes strong random ones here and in
# backend/.env, and changes the database and storage passwords in place.
#
# Not to be confused with backend/.env, which is handed to the backend
# CONTAINER. The ${...} placeholders in docker-compose.yml are resolved by
# Compose itself before any container starts, and Compose reads them from
# here (or the shell), never from backend/.env.

# --- TURN relay ---------------------------------------------------------
#
# TURN_PUBLIC_IP is the address the PHONES will use to reach this machine —
# your server's Tailscale IP. Not localhost, not a Docker service name, not
# the LAN address unless both phones are always on that LAN. Leave it unset
# and the backend serves no relay at all, which is the quiet way calls keep
# failing to connect.
TURN_PUBLIC_IP=

# Shared between coturn and the backend, which mints the short-lived
# credentials from it. The two MUST match or every relay auth fails. At least
# 32 random characters; docker/secure-setup.mjs makes one. The old example
# value was public, so the backend refuses to start on it.
TURN_SECRET=

# The relay port range, mapped through in docker-compose.yml. Twenty ports is
# plenty for two people; every mapped port costs a proxy process.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49180

# --- Calls ---------------------------------------------------------------
#
# This machine's Tailscale IP, for the call media server (the "calls"
# service). Falls back to TURN_PUBLIC_IP. In PowerShell:  tailscale ip -4
CALLS_PUBLIC_IP=

# Signs the passes the call server asks for before letting a phone into a
# call's room. Empty, anyone who reaches port 4100 can use it.
# docker/secure-setup.mjs makes one.
CALLS_SECRET=

# --- Postgres / MinIO ---------------------------------------------------
# Both are reachable from this PC only (127.0.0.1), never from the Wi-Fi or
# the tailnet. Still, change the passwords: docker/secure-setup.mjs does it,
# inside Postgres too (setting POSTGRES_PASSWORD here alone does nothing to a
# database that already exists).
# POSTGRES_USER=loversrock
# POSTGRES_PASSWORD=
# POSTGRES_DB=loversrock
# MINIO_ROOT_USER=loversrock
# MINIO_ROOT_PASSWORD=
