+// validJoinPass checks a pass the loversrock backend signed for one room.
+func validJoinPass(secret, room, pass string, now time.Time) bool {
+	dot := strings.IndexByte(pass, '.')
+	if dot <= 0 {
+		return false
+	}
+
+	expiry, err := strconv.ParseInt(pass[:dot], 10, 64)
+	if err != nil || now.Unix() > expiry {
+		return false
+	}
+
+	mac := hmac.New(sha256.New, []byte(secret))
+	mac.Write([]byte("join:" + room + ":" + pass[:dot]))
+	want := base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+
+	return hmac.Equal([]byte(want), []byte(pass[dot+1:]))
+}
